# Servidor
NODE_ENV=development
PORT=3100
HOST=127.0.0.1

# Banco
DATABASE_PATH=./data/fantasy2.db

# Auth
JWT_SECRET=troque-por-um-valor-aleatorio-de-pelo-menos-32-caracteres

# Front (origem permitida para cookies/CORS)
CORS_ORIGIN=http://localhost:5173

# Push notifications (Web Push) — gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@example.com

# Cloudflare R2 (fotos de itens de serviço) — bucket "fantasy2-hub-public"
# R2_ACCOUNT_ID: dashboard Cloudflare > R2 > Overview
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: R2 > Manage R2 API Tokens > Create (Object Read & Write)
# R2_PUBLIC_URL: URL pública do bucket (Public Development URL, ativado nas Settings do bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=fantasy2-hub-public
R2_PUBLIC_URL=
