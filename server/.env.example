# Servidor
NODE_ENV=development
PORT=3100
HOST=127.0.0.1

# Banco
DATABASE_PATH=./data/fantasy2.db

# Auth
JWT_SECRET=troque-por-um-valor-aleatorio-de-pelo-menos-32-caracteres

# Front (origem permitida para cookies/CORS)
CORS_ORIGIN=http://localhost:5173

# Push notifications (Web Push) — gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@example.com

# Cloudflare R2 (fotos de itens de serviço) — bucket "fantasy2-hub-public"
# R2_ACCOUNT_ID: dashboard Cloudflare > R2 > Overview
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: R2 > Manage R2 API Tokens > Create (Object Read & Write)
# R2_PUBLIC_URL: URL pública do bucket (Public Development URL, ativado nas Settings do bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=fantasy2-hub-public
R2_PUBLIC_URL=

# E-mail transacional (Resend) — esqueci minha senha (POST /auth/forgot-password), reset assistido
# pela admin, troca de e-mail, e retorno de aprovação/recusa de cadastro. RESEND_API_KEY:
# resend.com/api-keys (obrigatório para o servidor subir; use um placeholder local e troque pela
# chave real). EMAIL_FROM precisa ser um endereço de um domínio verificado na conta Resend
# (resend.com/domains) — sem isso o envio falha (fica só no log do servidor, não derruba a rota).
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Fantasy 2 Hub <nao-responda@example.com>

# RAG — opcional. Preferência: admin cadastra provedor + API key em /perguntar (nunca é devolvida pela API).
# OPENAI_API_KEY no .env só entra como fallback se nenhuma chave estiver salva no banco.
# Embeddings: text-embedding-3-small; resposta curta: gpt-4o-mini. Depois: npm run rag:reindex
OPENAI_API_KEY=

# WAHA — bot WhatsApp do grupo Fantasy 2 (opcional). Espelhe C:\Users\Gustavo\waha.env na VPS.
# Webhook: POST /waha/webhook (events message + message.any). Health: GET /waha/health
WAHA_ENABLED=false
WAHA_URL=http://127.0.0.1:3001
WAHA_API_KEY=
WAHA_SESSION=default
# Número do bot (só dígitos, E.164 sem +) — menções / anti-eco
WAHA_BOT_PHONE=
# JID do grupo Fantasy 2 (ex. 1203…@g.us) — descubra via WAHA Dashboard / GET /api/{session}/groups
WAHA_GROUP_ID=
WAHA_GROUP_NAME=Fantasy 2
# CSV de números (só dígitos) que podem mandar a mensagem "resumo" (ex. número do Gustavo)
WAHA_SUMMARY_ALLOWLIST=
# Opcional: header X-Webhook-Secret no POST /waha/webhook
WAHA_WEBHOOK_SECRET=
# SQLite por dia do chat do grupo (retenção 7 dias)
WAHA_CHAT_DATA_DIR=./data/waha-chats
